<%- include('partials/header') -%>
<div class="container">
  <div class="card mb-4">
      <div class="card-body">
        <h3 class="card-title">
        Personal Info
        </h3>
          <div>
              <p><strong>User Name</strong>: <%= user.userName %></p>
              <p><strong>Email</strong>: <%= user.email %></p>
              
          </div>

          <div class="d-flex justify-content-evenly mt-5">
          <a class="btn btn-primary" href="/dashboard">Return to dashboard</a>
          <a href="/logout" class="btn btn-secondary">Logout</a>
          </div>  
          
      </div>
      
    </div>

    <%# ------- CLIENT LIST ------%>
  <div class="card">
    <div class="card-body">
      <h2 class="card-title">Total clients: <%= clients.length%></h2>

      <table class="client-table" id="clients-list-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Frequency</th>
          </tr>
        </thead>
        <tbody>
        <% clients.forEach( el => { %>
          <tr>
            <td data-id='<%=el._id%>'><a href='/clients/<%= el._id %>'><%= el.name %></a></td>
            <td><%= el.address %></td>
            <td><span class="day-tag"><%= frequencies[el.frequency] %></span></td>

          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
<%- include('partials/footer') -%>