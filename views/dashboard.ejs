<%- include('partials/header') -%>
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Material+Icons" />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@calendarjs/ce/dist/style.css"
/>
<main class="container">

<%# ------- calendar UI ------%>
  <section class="card">
    <div class="card-body">
      <h2 class="card-title">Calendar</h2>
      <div id="workCalendar"></div>
    </div>
  </section>

   <%# ------- selected workDayList ------%>

  <section >
    <div class=" hidden" id="showWorkDayClients">
      <h2 >Work for the day:</h2>
        <div>
          <ul id="dayClients"></ul>
        </div>
    </div>
    <div class="card-body hidden" id="showWorkDayForm">
      <h2 class="card-title">add clients for Workday: </h2>
      <form action="/workDayList" method="POST" class="client-form">
        <div class="form-field">
          <label for="date" id="form-date"></label>
          <input type="hidden" id="date" name="date" />
        </div>

        <div class="clientList">
          <ul>
            <% clients.forEach( el =>{ %>
              <li>
                <input 
                  type="checkbox" 
                  
                  id="client_<%= el._id %>" 
                  name="clientIds" 
                  value="<%= el._id %>" 
                >
                <label for="client_<%= el._id %>"><%= el.name %></label>
              </li>
            <% }) %>
          </ul>
        </div>

        <input type="submit" value="Create workDayList" />
      </form>
    </div>
        
        
    </div>
  </section>
  
  <section class="card">
    <div class="card-body">
      <h2 class="card-title">Add a Client</h2>
      <form action="/clients/createClient" method="POST">
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientName"
            name="clientName"
            placeholder=""
          />
          <label for="clientName">Name</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientPhone"
            name="clientPhone"
            placeholder=""
          />
          <label for="clientPhone">Phone</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientAddress"
            name="clientAddress"
            placeholder=""
          />
          <label for="clientAddress">Address</label>
        </div>
        <div class="form-floating mb-3">
          <select class="form-select" id="clientDay" name="clientDay">
            <option value="Monday">Monday</option>
            <option value="Tuesday">Tuesday</option>
            <option value="Wednesday">Wednesday</option>
            <option value="Thursday">Thursday</option>
            <option value="Friday">Friday</option>
            <option value="Saturday">Saturday</option>
          </select>
          <label for="clientDay">Day</label>
        </div>
        <button type="submit" class="btn btn-primary mb-3" value="Add Client">
          Submit
        </button>
      </form>
    </div>
  </section>

  

   

  <%# ------- CREATE workDayList ------%>
  <section class="card">
    
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/lemonadejs/dist/lemonade.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@calendarjs/ce/dist/index.js"></script>

<script>
  const { Calendar } = calendarjs;

  Calendar(document.getElementById("workCalendar"), {
    type: "inline",
    value: new Date(),
    wheel: false,
    footer: false,
    onchange: function (self, value) {
      fetchClientsForDate(value);
      document.getElementById("form-date").innerHTML = value
    },
  });
</script>
<script src="js/main.js"></script>

<%- include('partials/footer') -%>
