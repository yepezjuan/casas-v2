<%- include('partials/header') -%>
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Material+Icons" />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@calendarjs/ce/dist/style.css"
/>
<main class="container">

<%# ------- calendar UI ------%>
  <section class="card">
    <div class="card-body">
      <h2 class="card-title">Calendar</h2>
      <div id="workCalendar"></div>
    </div>
  </section>



  <section >

<%# ------- selected workDayList ------%>

    <div class=" hidden" id="showWorkDayClients">
      <h2 >Work for the day:</h2>
        <div>
                    <div id="dayClients" class="clientList"></div>

        </div>

        <div class="route-summary hidden" id="routeSummary">
          <p id="routeTotals" class="route-totals"></p>
          <a id="routeLink" class="btn btn-success hidden" target="_blank" rel="noopener">Open in Google Maps</a>
          <p id="routeLinkNote" class="route-note hidden">Too many stops for a single Google Maps link.</p>
        </div>

    </div>

    <div class="workday-actions hidden" id="workDayActions">
      <button id="optimizeRoute" class="btn btn-primary hidden" type="button">Optimize route</button>
      <button id="editToggle" class="btn btn-secondary" type="button">Edit</button>
      <p id="routeStatus" class="route-note" role="status"></p>
    </div>

<%# ------- create / edit workDayList ------%>
    <div class="card-body hidden" id="showWorkDayForm">
      <h2 class="card-title">add clients for Workday: </h2>
      <form id="workDayForm" action="/workDayList" method="POST" class="client-form">
        <div class="form-field">
          <label for="date" id="form-date"></label>
          <input type="hidden" id="date" name="date" />
          <input type="hidden" id="listId" name="listId" />
        </div>

        <%# .btn-check hides the input but keeps it focusable; the label is the full-width row %>
<div class="clientList">
  <% clients.forEach( el =>{ %>
    <input type="checkbox" class="btn-check" id="client_<%= el._id %>"
           name="clientIds" value="<%= el._id %>" autocomplete="off">
    <label class="client-row" for="client_<%= el._id %>">
      <span class="check" aria-hidden="true"></span>
      <span class="client-row-name"><%= el.name %></span>
    </label>
  <% }) %>
</div>


        <input type="submit" id="workDayFormSubmit" value="Create workDayList" />
      </form>
    </div>
  </section>

<%# ------- Add Client form ------%>

  <section class="card">
    <div class="card-body">
      <h2 class="card-title">Add a Client</h2>
      <form action="/clients/createClient" method="POST">
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientName"
            name="clientName"
            placeholder=""
          />
          <label for="clientName">Name</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientPhone"
            name="clientPhone"
            placeholder=""
          />
          <label for="clientPhone">Phone</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientAddress"
            name="clientAddress"
            placeholder=""
          />
          <label for="clientAddress">Address</label>
        </div>
        <div class="form-floating mb-3">
          <select class="form-select" id="clientFrequency" name="clientFrequency">
            <% Object.entries(frequencies).forEach(([value, label]) => { %>
              <option value="<%= value %>"><%= label %></option>
            <% }) %>
          </select>
          <label for="clientFrequency">Frequency</label>
        </div>
        <button type="submit" class="btn btn-primary mb-3" value="Add Client">
          Submit
        </button>
      </form>
    </div>
  </section>


</main>

<script src="https://cdn.jsdelivr.net/npm/lemonadejs/dist/lemonade.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@calendarjs/ce/dist/index.js"></script>

<script>
  const { Calendar } = calendarjs;
  const today = new Date();
  const yearStart = `${today.getFullYear() - 1}-01-01`;
  const yearEnd = `${today.getFullYear() + 1}-01-01`;
  let scheduledDates = new Set();



  function markScheduledDays(calendarEl) {
    const monthLabel = calendarEl.querySelector('[data-view="months"]');
    const yearLabel = calendarEl.querySelector('[data-view="years"]');
    if (!monthLabel || !yearLabel) return;

    const monthIndex = new Date(`${monthLabel.textContent} 1, 2000`).getMonth();
    const year = parseInt(yearLabel.textContent, 10);

    calendarEl.querySelectorAll(".lm-calendar-content > div").forEach((cell) => {
      if (cell.dataset.grey === "true") {
        cell.classList.remove("workday-marker");
        return;
      }
      const day = parseInt(cell.textContent, 10);
      if (!day) return;
      const iso = `${year}-${String(monthIndex + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
      cell.classList.toggle("workday-marker", scheduledDates.has(iso));
    });
  }

  fetch(`/workDayList/dates?start=${yearStart}&end=${yearEnd}`)
    .then((res) => (res.ok ? res.json() : { dates: [] }))
    .catch(() => ({ dates: [] }))
    .then(({ dates }) => {
      scheduledDates = new Set(dates || []);

      const calendarEl = document.getElementById("workCalendar");

      Calendar(calendarEl, {
        type: "inline",
        value: new Date(),
        wheel: false,
        footer: false,
                onchange: function (self, value) {
          const pad = (n) => String(n).padStart(2, "0");
          const iso =
            value instanceof Date
              ? `${value.getFullYear()}-${pad(value.getMonth() + 1)}-${pad(value.getDate())}`
              : String(value || "").slice(0, 10);
          if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return;
          document.getElementById("form-date").textContent = iso;
          fetchClientsForDate(iso);
        },


        
      });

      markScheduledDays(calendarEl); 
      // initial render happens synchronously inside Calendar(...)

      const calendarObserver = new MutationObserver( () => markScheduledDays(calendarEl))
      calendarObserver.observe(calendarEl, {childList: true, subtree:true,
      characterData:true
      })
    });
</script>

<script src="js/main.js"></script>

<%- include('partials/footer') -%>
