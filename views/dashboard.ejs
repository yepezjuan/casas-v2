<%- include('partials/header') -%>
<%# NOTE: replaces the @calendarjs/ce stylesheet and the Material Icons font it
    needed for its arrows. The calendar is now our own component. %>
<link rel="stylesheet" href="/css/calendar.css" />
<main class="container">

<%# ------- calendar UI ------%>
<%# NOTE: same #workCalendar mount point as before; CasasCalendar fills it in
    from the init script at the bottom of this file. %>
      <div id="workCalendar"></div>




  <section >

<%# ------- selected workDayList ------%>

    <div class=" hidden" id="showWorkDayClients">
      <h2 >Work for the day:</h2>
        <div>
                    <div id="dayClients" class="clientList"></div>

        </div>

        <div class="route-summary hidden" id="routeSummary">
          <p id="routeTotals" class="route-totals"></p>
          <a id="routeLink" class="btn btn-success hidden" target="_blank" rel="noopener">Open in Google Maps</a>
          <p id="routeLinkNote" class="route-note hidden">Too many stops for a single Google Maps link.</p>
        </div>

    </div>

    <div class="workday-actions hidden" id="workDayActions">
      <button id="optimizeRoute" class="btn btn-primary hidden" type="button">Optimize route</button>
      <button id="editToggle" class="btn btn-secondary" type="button">Edit</button>
      <p id="routeStatus" class="route-note" role="status"></p>
    </div>

<%# ------- create / edit workDayList ------%>
    <div class="card-body hidden" id="showWorkDayForm">
      <h2 class="card-title">add clients for Workday: </h2>
      <form id="workDayForm" action="/workDayList" method="POST" class="client-form">
        <div class="form-field">
          <label for="date" id="form-date"></label>
          <input type="hidden" id="date" name="date" />
          <input type="hidden" id="listId" name="listId" />
        </div>

        <%# .btn-check hides the input but keeps it focusable; the label is the full-width row %>
<div class="clientList">
  <% clients.forEach( el =>{ %>
    <input type="checkbox" class="btn-check" id="client_<%= el._id %>"
           name="clientIds" value="<%= el._id %>" autocomplete="off">
    <label class="client-row" for="client_<%= el._id %>">
      <span class="check" aria-hidden="true"></span>
      <span class="client-row-name"><%= el.name %></span>
    </label>
  <% }) %>
</div>


        <input type="submit" id="workDayFormSubmit" value="Create workDayList" />
      </form>
    </div>
  </section>

<%# ------- Add Client form ------%>

  <section class="card">
    <div class="card-body">
      <h2 class="card-title">Add a Client</h2>
      <form action="/clients/createClient" method="POST">
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientName"
            name="clientName"
            placeholder=""
          />
          <label for="clientName">Name</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientPhone"
            name="clientPhone"
            placeholder=""
          />
          <label for="clientPhone">Phone</label>
        </div>
        <div class="form-floating mb-3">
          <input
            type="text"
            class="form-control"
            id="clientAddress"
            name="clientAddress"
            placeholder=""
          />
          <label for="clientAddress">Address</label>
        </div>
        <div class="form-floating mb-3">
          <select class="form-select" id="clientFrequency" name="clientFrequency">
            <% Object.entries(frequencies).forEach(([value, label]) => { %>
              <option value="<%= value %>"><%= label %></option>
            <% }) %>
          </select>
          <label for="clientFrequency">Frequency</label>
        </div>
        <button type="submit" class="btn btn-primary mb-3" value="Add Client">
          Submit
        </button>
      </form>
    </div>
  </section>


</main>

<%# NOTE: main.js used to load after the calendar script. It now loads first,
    because the init below calls its fetchClientsForDate straight away to show
    today's list. %>
<script src="/js/main.js"></script>

<%# NOTE: replaces the lemonadejs + @calendarjs/ce CDN scripts. %>
<script src="/js/calendar.js"></script>

<%# NOTE: replaces the old inline block (Calendar(...) init, markScheduledDays
    and the MutationObserver). Marked days are an option of the new calendar,
    so nothing reads the month back out of the DOM any more. %>
<script>
  const formDate = document.getElementById("form-date");
  // fast swipes: ignore a late answer for a month the user already left
  let marksToken = 0;

  // same two steps the old onchange did: label the form, load the day's list
  function selectDate(iso) {
    formDate.textContent = iso;
    fetchClientsForDate(iso);
  }

  const cal = CasasCalendar("#workCalendar", {
    value: new Date(),
    onChange: selectDate,
    // NOTE: was one fetch of a 3-year window up front; now only the 6 weeks
    // on screen are fetched, each time the month changes
    onMonthChange: ({ rangeStart, rangeEnd }) => {
      const token = ++marksToken;
      // /workDayList/dates treats `end` as exclusive, rangeEnd is the last
      // day shown, so ask for one day past it
      const last = CasasCalendar.fromISO(rangeEnd);
      const end = CasasCalendar.toISO(
        new Date(last.getFullYear(), last.getMonth(), last.getDate() + 1),
      );
      fetch(`/workDayList/dates?start=${rangeStart}&end=${end}`)
        .then((res) => (res.ok ? res.json() : { dates: [] }))
        .catch(() => ({ dates: [] }))
        .then(({ dates }) => {
          if (token === marksToken) cal.setMarkedDates(dates || []);
        });
    },
  });

  // NOTE: new behaviour. No onChange fires for the initial value, so today's
  // list is loaded by hand when the dashboard opens.
  selectDate(cal.getValue());
</script>

<%- include('partials/footer') -%>
