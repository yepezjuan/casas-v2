<%- include('partials/header') -%>

<main>
<div class="container">
  <div id="clientInfo" class="card">
    <div class="card-body">
      <h2><%= clientData.name %></h2>
      <div>
        <p><%= clientData.phone %></p>
        <p><%= clientData.address %></p>
        <p>Visited: <%= frequencies[clientData.frequency] %></p>
      </div>

     
    </div>
  </div>

  <div id="editClient" class="card hidden">
    <div class="card-body">
      <form action="/clients/updateClient?_method=PUT" method="POST">
        <h2>Edit client info</h2>
        <input type="hidden" name="clientId" value="<%= clientData._id %>" />
        <input type="text" placeholder="Name" class="form-control" name="clientName" required value="<%= clientData.name %>">
        <input type="tel" placeholder="Phone" name="clientPhone"  class="form-control" required value="<%= clientData.phone %>">
        <input type="text" placeholder="Address" name="clientAddress" class="form-control" required value="<%= clientData.address %>">
        <label for="clientFrequency">Frequency</label>
        <select class="form-select" id="clientFrequency" name="clientFrequency">
          <% Object.entries(frequencies).forEach(([value, label]) => { %>
            <option value="<%= value %>" <%= clientData.frequency === value ? "selected" : "" %>><%= label %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary">Save</button>

      </form>
    </div>

  </div>


  <div class="card">
    <div class="card-body">
      <h2>Dates Serviced:</h2>
       <div>
      <% if (serviceHistory.length) { %>
        <ul> <% serviceHistory.forEach( el =>{ %>
          <li><%= el %></li>
              <% }) %> </ul>
      <% } else { %>
        <p>No past visits yet</p>
      <% } %>
    </div>


    <div>
      
    </div>
     
    </div>
  </div>

  



 

  <div class="d-flex justify-content-evenly mt-5">
    <a class="btn btn-primary" href="/profile">Profile</a>
    <button id="editToggle" class="btn btn-secondary" type="button"> Edit</button>
    <form action="/clients/deleteClient?_method=DELETE" method="POST">
      <input
        type="hidden"
        name="clientIdFromJSFile"
        value="<%= clientData._id %>"
      />
      <button type="submit" class="btn btn-danger">Delete Client</button>
    </form>
  </div>
</div>

</main>

<script>
  const editToggle = document.getElementById("editToggle");
  const editPanel = document.getElementById("editClient");
const infoPanel = document.getElementById("clientInfo");

  editToggle.addEventListener("click", () => {
    const editing = editPanel.classList.contains("hidden");
    editPanel.classList.toggle("hidden", !editing);
    infoPanel.classList.toggle("hidden", editing);
    editToggle.textContent = editing ? "Cancel" : "Edit";
  });
</script>


<%- include('partials/footer') -%>
